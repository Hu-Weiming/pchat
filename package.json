{
  "name": "pchat",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm -r --if-present check",
    "check:tests": "tsc --noEmit -p tsconfig.tests.json",
    "check:deps": "node scripts/check-core-dependencies.mjs",
    "check:portable": "node scripts/check-portable-harness.mjs",
    "check:p1": "pnpm check && pnpm check:tests && pnpm test && pnpm check:deps && pnpm check:portable",
    "test": "vitest run --configLoader runner",
    "p0:runtime:build": "pnpm --filter @pchat/runtime-windows build",
    "p0:runtime:prepare-sidecar": "node scripts/prepare-runtime-sidecar.mjs",
    "p0:desktop:dev": "pnpm p0:runtime:build && pnpm --filter @pchat/desktop tauri dev",
    "p0:desktop:build": "pnpm p0:runtime:build && pnpm p0:runtime:prepare-sidecar && pnpm --filter @pchat/desktop tauri build"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
