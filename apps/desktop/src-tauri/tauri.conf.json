{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pchat P0",
  "version": "0.0.0",
  "identifier": "com.pchat.agent",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pchat P0 技术验证",
        "width": 820,
        "height": 680,
        "minWidth": 640,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [],
    "externalBin": ["binaries/pchat-node"],
    "resources": {
      "../../runtime-windows/dist/main.mjs": "runtime/main.mjs"
    }
  }
}
