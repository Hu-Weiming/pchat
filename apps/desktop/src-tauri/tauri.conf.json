{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pchat Agent",
  "version": "0.1.0",
  "identifier": "com.pchat.agent",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pchat · 思想之间",
        "width": 1280,
        "height": 860,
        "minWidth": 860,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [],
    "externalBin": [
      "binaries/pchat-node"
    ],
    "resources": {
      "../../runtime-windows/dist/main.mjs": "runtime/main.mjs"
    }
  }
}
